# FoodLoop AI Environment Variables

# Backend Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Database connection:
# SQLite (default out-of-the-box zero-dependency):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production / Docker Compose alternative):
# DATABASE_URL="postgresql://foodloop:foodloop_pass@localhost:5432/foodloop_db?schema=public"

# Authentication
JWT_SECRET=replace_with_strong_random_secret_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Optional external service placeholders (P1)
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# MAPS_API_KEY=
